{
  "schema_version": "1.0",
  "state_root": ".session/evaluation-arena",
  "partitions": [
    "TUNE",
    "HOLDOUT"
  ],
  "task_kinds": [
    "QA",
    "CODE",
    "RESEARCH",
    "GENERAL"
  ],
  "evaluator_kinds": [
    "DETERMINISTIC",
    "HUMAN",
    "JUDGE"
  ],
  "score_min": 0.0,
  "score_max": 1.0,
  "max_source_refs": 64,
  "max_tags": 32,
  "max_strategy_params": 32,
  "max_model_calls": 64,
  "max_tool_calls": 256,
  "forbidden_keys": [
    "reasoning",
    "chain_of_thought",
    "scratchpad",
    "hidden_deliberation",
    "private_reasoning",
    "raw_model_reasoning"
  ],
  "quality_floor_required": true,
  "experiment_outputs_canonical": false,
  "execution_authority": "NONE",
  "automatic_promotion": false,
  "max_trials": 5000,
  "required_frontier_metrics": [
    "quality_score",
    "wall_time_ms"
  ],
  "optional_frontier_metrics": [
    "input_tokens_total",
    "model_calls",
    "tool_calls",
    "rework_count"
  ],
  "metric_directions": {
    "quality_score": "MAXIMIZE",
    "wall_time_ms": "MINIMIZE",
    "input_tokens_total": "MINIMIZE",
    "model_calls": "MINIMIZE",
    "tool_calls": "MINIMIZE",
    "rework_count": "MINIMIZE"
  },
  "max_suite_cases": 500,
  "max_suite_variants": 128,
  "max_experiment_config_items": 32
}
