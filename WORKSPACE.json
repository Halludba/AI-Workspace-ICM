    "context_protocol": "_core/CONTEXT_PROTOCOL.md",
    "reference_policy": "_core/REFERENCE_POLICY.md",
    "route_registry": "config/routes.json",
    "context_policy": "config/context_policy.json",
    "context_resolver": "tools/context_resolver.py",
    "workflow_protocol": "_core/WORKFLOW_PROTOCOL.md",
    "stage_protocol": "_core/STAGE_PROTOCOL.md",
    "workflow_policy": "config/workflow_policy.json",
    "workflow_validator": "tools/workflow_validator.py",
    "workflow_creator": "tools/create_workflow.py",
    "run_protocol": "_core/RUN_PROTOCOL.md",
