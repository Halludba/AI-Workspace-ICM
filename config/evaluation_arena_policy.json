{
  "schema_version": "1.0",
  "state_root": ".session/evaluation-arena",
  "partitions": [
    "TUNE",
    "HOLDOUT"
  ],
  "task_kinds": [
    "QA",
    "CODE",
    "RESEARCH",
    "GENERAL"
  ],
  "evaluator_kinds": [
    "DETERMINISTIC",
    "HUMAN",
    "JUDGE"
  ],
  "score_min": 0.0,
  "score_max": 1.0,
  "max_source_refs": 64,
  "max_tags": 32,
  "max_strategy_params": 32,
  "max_model_calls": 64,
  "max_tool_calls": 256,
  "forbidden_keys": [
    "reasoning",
    "chain_of_thought",
    "scratchpad",
    "hidden_deliberation",
    "private_reasoning",
    "raw_model_reasoning"
  ],
  "quality_floor_required": true,
  "experiment_outputs_canonical": false,
  "execution_authority": "NONE",
  "automatic_promotion": false,
  "max_trials": 5000,
  "required_frontier_metrics": [
    "quality_score",
    "wall_time_ms"
  ],
  "optional_frontier_metrics": [
    "input_tokens_total",
    "model_calls",
    "tool_calls",
    "rework_count"
  ],
  "metric_directions": {
    "quality_score": "MAXIMIZE",
    "wall_time_ms": "MINIMIZE",
    "input_tokens_total": "MINIMIZE",
    "model_calls": "MINIMIZE",
    "tool_calls": "MINIMIZE",
    "rework_count": "MINIMIZE"
  },
  "max_suite_cases": 500,
  "max_suite_variants": 128,
  "max_experiment_config_items": 32,
  "strategy_runner": {
    "max_variants": 8,
    "max_cases": 64,
    "max_trials": 128,
    "max_replicates": 4,
    "allowlisted_dimensions": [
      "model_ref",
      "context_policy_ref",
      "planner_enabled",
      "verification_mode",
      "strategy_params.context_level"
    ],
    "strategy_param_allowlist": {
      "context_level": [
        "C0",
        "C1",
        "C2",
        "C3",
        "C4",
        "C5"
      ]
    },
    "budget_maxima": {
      "wall_time_ms": 600000.0,
      "model_calls": 64.0,
      "tool_calls": 256.0,
      "input_tokens_total": 1000000.0
    },
    "required_budget_metrics": [
      "wall_time_ms",
      "model_calls",
      "tool_calls"
    ],
    "optional_token_budget_metric": "input_tokens_total",
    "early_stop": {
      "min_trials": 1,
      "quality_floor_failure": true,
      "failed_or_blocked": true
    },
    "executor_partition_visible": false,
    "executor_evaluator_visible": false,
    "automatic_promotion": false
  },
  "ablation": {
    "cost_metrics": [
      "wall_time_ms",
      "input_tokens_total",
      "model_calls",
      "tool_calls",
      "rework_count"
    ],
    "minimum_relative_improvement": 0.05,
    "maximum_quality_regression": 0.01,
    "automatic_removal": false,
    "quality_floor_required": true
  },
  "local_worker_benchmark": {
    "capability_id": "LOCAL_CODE_WORKER",
    "minimum_valid_tool_call_rate": 0.98,
    "minimum_scope_compliance_rate": 1.0,
    "minimum_verified_success_rate": 0.8,
    "maximum_unnecessary_tool_call_rate": 0.25,
    "frontier_metrics": {
      "verified_success_rate": "MAXIMIZE",
      "patch_correctness_rate": "MAXIMIZE",
      "unnecessary_tool_call_rate": "MINIMIZE",
      "wall_time_ms_median": "MINIMIZE",
      "input_tokens_total_median": "MINIMIZE",
      "repair_count_median": "MINIMIZE",
      "vram_peak_mib_median": "MINIMIZE",
      "coding_quality_score_median": "MAXIMIZE"
    },
    "automatic_promotion": false
  }
}
