{
  "schema_version": "1.0",
  "max_packet_estimated_tokens": 20000,
  "max_context_items": 32,
  "max_changed_files": 20,
  "max_repair_cycles": 1,
  "session_state_root": ".session/workers",
  "require_current_base_revision": true,
  "structured_output_required": true,
  "capture_private_reasoning": false,
  "canonical_mutation": false,
  "result_statuses": [
    "SUCCESS",
    "NEEDS_REPAIR",
    "BLOCKED"
  ],
  "test_statuses": [
    "PROPOSED",
    "NOT_RUN"
  ],
  "max_response_bytes": 4194304,
  "max_patch_bytes": 2097152,
  "capability_id": "LOCAL_CODE_WORKER",
  "provider_registry": "config/local_worker_providers.json"
}
