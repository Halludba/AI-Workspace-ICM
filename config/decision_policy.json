  "required_record_fields": [
    "record_version",
    "record_id",
    "recorded_utc",
    "directive_id",
    "actor_id",
    "objective",
    "constraints",
    "claims",
    "evidence",
    "assumptions",
    "alternatives",
    "decision",
    "unknowns",
    "verification",
    "links",
    "privacy_attestation"
  ],  "allowed_record_fields": [
    "record_version",
    "record_id",
    "recorded_utc",
    "directive_id",
    "actor_id",
    "supersedes_record_id",
    "objective",
    "constraints",
    "claims",
    "evidence",
    "assumptions",
    "alternatives",
    "decision",
    "unknowns",
    "verification",
    "links",
    "privacy_attestation"
  ],
  "item_array_fields": [
    "constraints",
    "claims",
    "assumptions",
    "unknowns"
  ],
  "evidence_availability": ["AVAILABLE", "PARTIAL", "MISSING"],
  "alternative_dispositions": ["SELECTED", "REJECTED", "DEFERRED", "NO_CHANGE"],
