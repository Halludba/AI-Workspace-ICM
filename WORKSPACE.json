{
  "workspace_schema": "1.2",
  "workspace_version": "0.3.0",
  "workspace_name": "AI Workspace ICM",
  "architecture": "filesystem-first-context-routing",
  "canonical_branch": "main",
  "status": "WORKFLOW_ARCHITECTURE",
  "entrypoints": {
    "orientation": "WORKSPACE.md",
    "router": "CONTEXT.md",
    "conventions": "_core/CONVENTIONS.md",
    "authority": "_core/AUTHORITY.md",
    "state_model": "_core/STATE_MODEL.md",
    "context_protocol": "_core/CONTEXT_PROTOCOL.md",
    "reference_policy": "_core/REFERENCE_POLICY.md",
    "route_registry": "config/routes.json",
    "context_policy": "config/context_policy.json",
    "context_resolver": "tools/context_resolver.py",
    "workflow_protocol": "_core/WORKFLOW_PROTOCOL.md",
    "stage_protocol": "_core/STAGE_PROTOCOL.md",
    "workflow_policy": "config/workflow_policy.json",
    "workflow_validator": "tools/workflow_validator.py",
    "workflow_creator": "tools/create_workflow.py"
  },
  "roots": {
    "core": "_core",
    "config": "config",
    "references": "references",
    "profiles": "profiles",
    "skills": "skills",
    "workflows": "workflows",
    "runs": "work",
    "tools": "tools",
    "tests": "tests",
    "archive": "archive"
  },
  "legacy_source": {
    "repository": "Halludba/AI-Workspace",
    "authority": "migration_reference_only"
  }
}
