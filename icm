#!/usr/bin/env python3
"""ICM workspace trampoline for run, assurance, inspection, role/capability routing, and capsule export."""
from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))


def _dispatch() -> int:
    if len(sys.argv) < 2 or sys.argv[1] not in {"run", "assurance", "inspect", "role", "capability", "worker", "plan", "observe", "advise", "arena", "interaction", "suggestions", "present", "evidence", "local-exec", "export"}:
        print("usage: icm {run,assurance,inspect,role,capability,worker,plan,observe,advise,arena,interaction,suggestions,present,evidence,local-exec,export <command> [args]", file=sys.stderr)
        return 2
    surface = sys.argv[1]
    if surface == "inspect":
        if len(sys.argv) < 3 or sys.argv[2] not in {"tokens", "benchmark", "source", "escalation", "runtime", "compute"}:
            print("usage: icm inspect {tokens,benchmark,source,escalation,runtime,compute} <command> [args]", file=sys.stderr)
            return 2
        inspector = sys.argv[2]
        sys.argv = [sys.argv[0], *sys.argv[3:]]
        if inspector == "tokens":
            from tools.token_profiler import main as token_main
            return token_main()
        if inspector == "benchmark":
            from tools.context_benchmark import main as benchmark_main
            return benchmark_main()
        if inspector == "source":
            from tools.source_navigator import main as source_main
            return source_main()
        if inspector == "escalation":
            from tools.context_escalation import main as escalation_main
            return escalation_main()
        if inspector == "runtime":
            from tools.context_runtime import main as runtime_main
            return runtime_main()
        from tools.local_compute import main as compute_main
        return compute_main()
    if surface == "role":
        from tools.role_resolver import main as role_main
        sys.argv = [sys.argv[0], *sys.argv[2:]]
        return role_main()
    if surface == "capability":
        from tools.capability_resolver import main as capability_main
        sys.argv = [sys.argv[0], *sys.argv[2:]]
        return capability_main()
    if surface == "advise":
        from tools.meta_advisor import main as advise_main
        sys.argv = [sys.argv[0], *sys.argv[2:]]
        return advise_main()
    if surface == "arena":
        from tools.evaluation_arena import main as arena_main
        sys.argv = [sys.argv[0], *sys.argv[2:]]
        return arena_main()
    if surface == "interaction":
        from tools.interaction_contracts import main as interaction_main
        sys.argv = [sys.argv[0], *sys.argv[2:]]
        return interaction_main()
    if surface == "suggestions":
        from tools.suggestion_queue import main as suggestions_main
        sys.argv = [sys.argv[0], *sys.argv[2:]]
        return suggestions_main()
    if surface == "present":
        from tools.continuity_presenter import main as present_main
        sys.argv = [sys.argv[0], *sys.argv[2:]]
        return present_main()
    if surface == "observe":
        from tools.developer_observatory import main as observe_main
        sys.argv = [sys.argv[0], *sys.argv[2:]]
        return observe_main()
    if surface == "evidence":
        from tools.evidence_reuse import main as evidence_main
        sys.argv = [sys.argv[0], *sys.argv[2:]]
        return evidence_main()
    if surface == "local-exec":
        from tools.local_execution import main as local_exec_main
        sys.argv = [sys.argv[0], *sys.argv[2:]]
        return local_exec_main()
    if surface == "plan":
        command = sys.argv[2] if len(sys.argv) > 2 else None
        sys.argv = [sys.argv[0], *sys.argv[2:]]
        if command and command.startswith("window-"):
            from tools.session_planner import main as session_plan_main
            return session_plan_main()
        from tools.plan_intelligence import main as plan_main
        return plan_main()
    if surface == "worker":
        from tools.local_worker import main as worker_main
        sys.argv = [sys.argv[0], *sys.argv[2:]]
        return worker_main()
    if surface == "export":
        if len(sys.argv) < 3 or sys.argv[2] != "capsule":
            print("usage: icm export capsule [args]", file=sys.stderr)
            return 2
        from tools.capsule_exporter import main as capsule_main
        sys.argv = [sys.argv[0], *sys.argv[3:]]
        return capsule_main()
    sys.argv = [sys.argv[0], *sys.argv[2:]]
    if surface == "run":
        from tools.run_manager import main as run_main
        return run_main()
    from tools.assurance_controller import main as assurance_main
    return assurance_main()


def main() -> int:
    surface=sys.argv[1] if len(sys.argv)>1 else 'unknown'
    command=sys.argv[2] if len(sys.argv)>2 else None
    capture=(ROOT/'.session'/'observatory'/'CAPTURE.json').is_file()
    if not capture:
        result=_dispatch()
        if result==0 and surface=='plan' and command=='window-open' and '--help' not in sys.argv:
            try:
                import time
                from tools.developer_observatory import capture_start
                agent=sys.argv[3] if len(sys.argv)>3 else 'unknown'
                capture_start(f'window-{agent}-{time.time_ns()}', 'NORMAL', ROOT)
            except Exception:
                pass
        return result
    import time
    started=time.perf_counter(); result=2; outcome='FAILED'
    try:
        result=_dispatch(); outcome='SUCCESS' if result==0 else 'FAILED'; return result
    except SystemExit as exc:
        code=exc.code if isinstance(exc.code,int) else 0; outcome='SUCCESS' if code==0 else 'FAILED'; raise
    finally:
        duration_ms=(time.perf_counter()-started)*1000.0
        try:
            from tools.developer_observatory import record_cli_measurement, capture_stop
            record_cli_measurement(surface,command,duration_ms,outcome,ROOT)
            if surface=='plan' and command=='window-close' and outcome=='SUCCESS': capture_stop(ROOT)
        except Exception:
            pass


if __name__ == "__main__":
    raise SystemExit(main())
