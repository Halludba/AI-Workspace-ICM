{
  "schema_version": "1.0",
  "state_root": ".session/observatory",
  "modes": [
    "NORMAL",
    "DEVELOPER",
    "AUDIT"
  ],
  "phases": [
    "ORIENTATION",
    "PLANNING",
    "RETRIEVAL",
    "IMPLEMENTATION",
    "VERIFICATION",
    "RECONCILIATION",
    "RESEARCH",
    "OUTPUT"
  ],
  "outcomes": [
    "SUCCESS",
    "BLOCKED",
    "FAILED",
    "REWORK"
  ],
  "rework_classes": [
    "EXPECTED_VERIFICATION_REWORK",
    "AVOIDABLE_IMPLEMENTATION_REWORK",
    "REQUIREMENT_CHANGE",
    "EXTERNAL_CHANGE",
    "EXPLORATORY_REWORK"
  ],
  "forbidden_keys": [
    "reasoning",
    "chain_of_thought",
    "scratchpad",
    "hidden_deliberation",
    "raw_prompt",
    "raw_response",
    "conversation_transcript"
  ],
  "normal_mode_model_calls": false,
  "canonical": false,
  "execution_authority": "NONE",
  "max_context_refs": 64,
  "max_directive_refs": 64,
  "max_causal_refs": 64,
  "efficiency_review": {
    "absolute_slow_session_ms": 900000,
    "relative_to_median_multiplier": 1.5,
    "minimum_baseline_sessions": 3,
    "top_mechanisms": 5,
    "private_reasoning_source_allowed": false
  },
  "mechanism_roi": {
    "minimum_events": 3,
    "minimum_sessions": 2,
    "high_cost_share": 0.15,
    "top_candidates": 5,
    "ablation_required_for_worth_claim": true
  },
  "capture": {
    "state_file": ".session/observatory/CAPTURE.json",
    "allowed_modes": [
      "NORMAL",
      "DEVELOPER"
    ],
    "record_cli": true
  }
}
