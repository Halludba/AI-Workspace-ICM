{
  "schema_version": "1.0",
  "run_root": "work",
  "template_path": "work/_template",
  "run_id_pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9]+(?:-[a-z0-9]+)*$",
  "required_run_files": [
    "RUN.md",
    "RUN.json"
  ],
  "required_run_directories": [
    "definition",
    "inputs",
    "stages",
    "final"
  ],
  "required_run_sections": [
    "Purpose",
    "Workflow",
    "Current State",
    "Resume",
    "Artifacts"
  ],
  "workflow_required_status": "ACTIVE",
  "workflow_must_be_executable": true,
  "run_statuses": [
    "TEMPLATE",
    "READY",
    "RUNNING",
    "BLOCKED",
    "COMPLETED",
    "FAILED",
    "CANCELLED"
  ],
  "resumable_statuses": [
    "READY",
    "RUNNING",
    "BLOCKED"
  ],
  "terminal_statuses": [
    "COMPLETED",
    "FAILED",
    "CANCELLED"
  ],
  "attempt_statuses": [
    "PENDING",
    "RUNNING",
    "SUCCEEDED",
    "FAILED",
    "BLOCKED",
    "CANCELLED"
  ],
  "validation_statuses": [
    "NOT_RUN",
    "PASS",
    "FAIL",
    "BLOCKED"
  ],
  "attempt_directory_pattern": "^[0-9]{4}$",
  "artifact_hash": "sha256",
  "definition_snapshot_required": true,
  "initial_attempt_number": 1,
  "initial_execution_sequence": 1,
  "initial_run_status": "READY",
  "initial_attempt_status": "PENDING",
  "initial_validation_status": "NOT_RUN",
  "template_status": "TEMPLATE",
  "template_is_executable": false,
  "require_terminal_stage_for_completion": true,
  "require_hash_match": true,
  "reject_path_escape": true,
  "allow_external_artifact_locators": true
}
