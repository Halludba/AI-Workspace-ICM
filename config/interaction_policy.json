{
  "schema_version": "1.0",
  "authority": "SUBORDINATE_SHARED_INVARIANTS",
  "grants_execution_authority": false,
  "grants_mutation_authority": false,
  "automatic_rule_deletion": false,
  "components": {
    "planner": "_core/PLAN_INTELLIGENCE_PROTOCOL.md",
    "git_state": "_core/STATE_MODEL.md",
    "context": "_core/CONTEXT_PROTOCOL.md",
    "assurance": "_core/ASSURANCE_PROTOCOL.md",
    "role": "_core/ROLE_PROTOCOL.md",
    "mutation": "_core/CONVENTIONS.md",
    "worker": "_core/LOCAL_WORKER_PROTOCOL.md",
    "governance": "_core/AUTHORITY.md",
    "observatory": "_core/DEVELOPER_OBSERVATORY_PROTOCOL.md",
    "meta_advisor": "_core/META_ADVISOR_PROTOCOL.md",
    "arena": "_core/EVALUATION_ARENA_PROTOCOL.md",
    "capability": "skills/CONTEXT.md",
    "host_capability": "_core/LOCAL_COMPUTE_PROTOCOL.md",
    "suggestion": "_core/SUGGESTION_PROTOCOL.md",
    "presentation": "_core/HUMAN_PRESENTATION_PROTOCOL.md",
    "evidence_reuse": "_core/EVIDENCE_REUSE_PROTOCOL.md",
    "local_execution": "_core/LOCAL_EXECUTION_PLANE_PROTOCOL.md"
  },
  "invariants": [
    {
      "id": "INV-PLANNER-NONAUTH",
      "statement": "Planner intent never overrides current canonical Git/run truth.",
      "source_refs": [
        "_core/STATE_MODEL.md",
        "_core/PLAN_INTELLIGENCE_PROTOCOL.md"
      ]
    },
    {
      "id": "INV-CONTEXT-NOT-ASSURANCE",
      "statement": "Loading more context can provide evidence but does not itself raise assurance.",
      "source_refs": [
        "_core/CONTEXT_PROTOCOL.md",
        "_core/ASSURANCE_PROTOCOL.md"
      ]
    },
    {
      "id": "INV-ROLE-NOT-AUTH",
      "statement": "Role selection never grants mutation authorization by itself.",
      "source_refs": [
        "_core/ROLE_PROTOCOL.md",
        "_core/AUTHORITY.md"
      ]
    },
    {
      "id": "INV-WORKER-CANDIDATE",
      "statement": "Worker output remains a candidate until architect review and deterministic governance accept it.",
      "source_refs": [
        "_core/LOCAL_WORKER_PROTOCOL.md",
        "_core/AUTHORITY.md"
      ]
    },
    {
      "id": "INV-USAGE-NOT-CAUSAL",
      "statement": "Observed usage or timing does not by itself prove causal value.",
      "source_refs": [
        "_core/DEVELOPER_OBSERVATORY_PROTOCOL.md",
        "_core/META_ADVISOR_PROTOCOL.md"
      ]
    },
    {
      "id": "INV-ARENA-NO-PROMOTION",
      "statement": "An Evaluation Arena winner cannot automatically change canonical ICM behavior.",
      "source_refs": [
        "_core/EVALUATION_ARENA_PROTOCOL.md",
        "_core/AUTHORITY.md"
      ]
    },
    {
      "id": "INV-SKILL-NOT-CAPABILITY",
      "statement": "Selecting a skill does not create host capability or mutation authority.",
      "source_refs": [
        "skills/CONTEXT.md",
        "_core/LOCAL_COMPUTE_PROTOCOL.md"
      ]
    },
    {
      "id": "INV-SILENCE-NOT-AUTH",
      "statement": "Silence or topic change never authorizes suggestion execution or mutation.",
      "source_refs": [
        "_core/SUGGESTION_PROTOCOL.md",
        "_core/AUTHORITY.md"
      ]
    },
    {
      "id": "INV-SUGGESTION-PLANNER",
      "statement": "Only accepted suggestions are eligible for planner promotion, and promotion still requires planner/governance validation.",
      "source_refs": [
        "_core/SUGGESTION_PROTOCOL.md",
        "_core/PLAN_INTELLIGENCE_PROTOCOL.md"
      ]
    },
    {
      "id": "INV-PRESENTATION-NOT-AUTH",
      "statement": "Human-facing presentation can summarize planner/suggestion state but cannot change rigor or authority.",
      "source_refs": [
        "_core/HUMAN_PRESENTATION_PROTOCOL.md",
        "_core/AUTHORITY.md"
      ]
    },
    {
      "id": "INV-EVIDENCE-DEPENDENCY-COMPLETE",
      "statement": "Reusable evidence is valid only while every declared dependency and required environment fingerprint remains unchanged.",
      "source_refs": [
        "_core/EVIDENCE_REUSE_PROTOCOL.md",
        "_core/STATE_MODEL.md"
      ]
    },
    {
      "id": "INV-VERIFICATION-REVISION-BOUND",
      "statement": "Verification evidence belongs to the exact tested repository state and becomes stale, not current proof, when that state changes.",
      "source_refs": [
        "_core/LOCAL_EXECUTION_PLANE_PROTOCOL.md",
        "_core/EVIDENCE_REUSE_PROTOCOL.md"
      ]
    },
    {
      "id": "INV-WORKER-ISOLATED-MUTATION",
      "statement": "Parallel intelligent mutations use isolated worktrees or an explicit exclusive lease; worker results never share uncontrolled canonical mutable state.",
      "source_refs": [
        "_core/LOCAL_EXECUTION_PLANE_PROTOCOL.md",
        "_core/LOCAL_WORKER_PROTOCOL.md"
      ]
    }
  ],
  "contracts": [
    {
      "id": "planner-git",
      "left": "planner",
      "right": "git_state",
      "invariants": [
        "INV-PLANNER-NONAUTH"
      ]
    },
    {
      "id": "context-assurance",
      "left": "context",
      "right": "assurance",
      "invariants": [
        "INV-CONTEXT-NOT-ASSURANCE"
      ]
    },
    {
      "id": "role-mutation",
      "left": "role",
      "right": "mutation",
      "invariants": [
        "INV-ROLE-NOT-AUTH"
      ]
    },
    {
      "id": "worker-governance",
      "left": "worker",
      "right": "governance",
      "invariants": [
        "INV-WORKER-CANDIDATE"
      ]
    },
    {
      "id": "observatory-meta-advisor",
      "left": "observatory",
      "right": "meta_advisor",
      "invariants": [
        "INV-USAGE-NOT-CAUSAL"
      ]
    },
    {
      "id": "arena-governance",
      "left": "arena",
      "right": "governance",
      "invariants": [
        "INV-ARENA-NO-PROMOTION"
      ]
    },
    {
      "id": "capability-host",
      "left": "capability",
      "right": "host_capability",
      "invariants": [
        "INV-SKILL-NOT-CAPABILITY"
      ]
    },
    {
      "id": "suggestion-governance",
      "left": "suggestion",
      "right": "governance",
      "invariants": [
        "INV-SILENCE-NOT-AUTH"
      ]
    },
    {
      "id": "suggestion-planner",
      "left": "suggestion",
      "right": "planner",
      "invariants": [
        "INV-SUGGESTION-PLANNER"
      ]
    },
    {
      "id": "presentation-planner",
      "left": "presentation",
      "right": "planner",
      "invariants": [
        "INV-PRESENTATION-NOT-AUTH"
      ]
    },
    {
      "id": "presentation-suggestion",
      "left": "presentation",
      "right": "suggestion",
      "invariants": [
        "INV-PRESENTATION-NOT-AUTH"
      ]
    },
    {
      "id": "evidence-git",
      "left": "evidence_reuse",
      "right": "git_state",
      "invariants": [
        "INV-EVIDENCE-DEPENDENCY-COMPLETE"
      ]
    },
    {
      "id": "execution-evidence",
      "left": "local_execution",
      "right": "evidence_reuse",
      "invariants": [
        "INV-VERIFICATION-REVISION-BOUND"
      ]
    },
    {
      "id": "execution-worker",
      "left": "local_execution",
      "right": "worker",
      "invariants": [
        "INV-WORKER-ISOLATED-MUTATION",
        "INV-WORKER-CANDIDATE"
      ]
    }
  ],
  "maintenance": {
    "events": [
      "COMPONENT_CHANGE",
      "LOCAL_SEAL",
      "PUBLICATION"
    ],
    "structural_validation_on_component_change": true,
    "structural_validation_on_local_seal": true,
    "structural_validation_on_publication": true,
    "semantic_review_on_multi_component_change": true,
    "semantic_review_publication_commit_interval": 5,
    "automatic_rule_deletion": false
  }
}
