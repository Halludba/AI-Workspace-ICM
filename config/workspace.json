{
  "config_schema": "1.1",
  "context_loading": {
    "default": "SCOPED",
    "allow_global_escalation": true,
    "global_requires_reason": true,
    "protocol": "_core/CONTEXT_PROTOCOL.md",
    "route_registry": "config/routes.json",
    "policy": "config/context_policy.json"
  },
  "execution": {
    "fail_closed": true,
    "fabricated_execution_claims_forbidden": true
  },
  "history": {
    "canonical": "git",
    "conversation_history_authority": "evidence_only"
  },
  "interaction": {
    "visible_role_prefix": "╰── ֎ [<ROLE OR AGENT NAME>] ◄",
    "blank_line_after_prefix": true
  },
  "planning": {
    "major_step_policy": "one-at-a-time",
    "preserve_future_steps_durably": true
  },
  "portability": {
    "host_neutral_canonical_contracts": true
  }
}
